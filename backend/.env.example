# ==========================================
# DIGITICK BACKEND CONFIGURATION
# ==========================================

# Server
ENVIRONMENT=development
PORT=8000

# Security (Change in production)
JWT_SECRET=digitick-super-secret-key-change-in-production-2026

# Database
# For Local Development (Zero setup required):
DATABASE_URL=sqlite:///./digitick.db
# For Supabase PostgreSQL (Set from your Supabase project settings -> Database -> URI):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase Auth & Storage (Optional if using Supabase client directly)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=[YOUR-ANON-KEY]
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SERVICE-ROLE-KEY]

# Google Cloud Vision / Gemini AI (For handwritten list OCR)
# Get a key from https://aistudio.google.com/ or Google Cloud Console
GEMINI_API_KEY=

# Google Maps Platform (For live Google Places & Directions)
GOOGLE_MAPS_API_KEY=

